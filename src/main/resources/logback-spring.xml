<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- 사람이 읽기 쉬운 터미널 출력 -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [requestId=%X{requestId:-none}] %logger{36} - %msg %kvp%n%wEx
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 일반 애플리케이션 JSON 로그 -->
    <appender name="APPLICATION_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/application.json</file>

        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/archive/application-%d{yyyy-MM-dd}.%i.json.gz
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 보안 및 관리자 행위 감사 로그 -->
    <appender name="AUDIT_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/audit.json</file>

        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>logstash</format>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/archive/audit-%d{yyyy-MM-dd}.%i.json.gz
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 일반 애플리케이션 로그 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APPLICATION_FILE"/>
    </root>

    <!-- Audit 로그는 일반 파일과 분리 -->
    <logger name="AUDIT"
            level="INFO"
            additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <!-- SQL과 바인딩 파라미터는 로컬 환경에서만 출력 -->
    <springProfile name="local">

        <appender name="SQL_FILE"
                  class="ch.qos.logback.core.rolling.RollingFileAppender">

            <file>${LOG_PATH}/sql.log</file>

            <encoder>
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [requestId=%X{requestId:-none}] %logger{36} - %msg%n
                </pattern>
                <charset>UTF-8</charset>
            </encoder>

            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>
                    ${LOG_PATH}/archive/sql-%d{yyyy-MM-dd}.%i.log.gz
                </fileNamePattern>
                <maxFileSize>5MB</maxFileSize>
                <maxHistory>3</maxHistory>
                <totalSizeCap>20MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <logger name="org.hibernate.SQL"
                level="DEBUG"
                additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="SQL_FILE"/>
        </logger>

        <logger name="org.hibernate.orm.jdbc.bind"
                level="TRACE"
                additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="SQL_FILE"/>
        </logger>

    </springProfile>

</configuration>